# ==========================================
# LARA OS - Backend Environment Configuration
# ==========================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Gemini / LLM Configuration
# Provide your Gemini API key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=
MODEL_NAME=gemini-2.5-flash
MAX_OUTPUT_TOKENS=2048
TEMPERATURE=0.7

# Phase 2: model provider, memory recall and bounded planning
AI_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
MODEL_TIMEOUT_SECONDS=30
MEMORY_CONTEXT_CHARS=6000
AGENT_MAX_STEPS=8
TOOL_READ_RETRIES=1
# Local JSON stores support one backend worker. Do not enable multi-worker serving.
